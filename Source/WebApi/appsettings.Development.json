{
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss.fff ",
        "UseUtcTimestamp": false,
        "IncludeScopes": false
      }
    }
  },
  "Settings": {
    "Databases": [
      {
        "Host": "localhost",
        "Sql": {
          "MigrateOnStartup": true
        }
      }
    ],
    "Scheduling": {
      "Dashboard": { "Enabled": true, "ReadOnly": false }
    }
  },
  "Api": {
    "Documentation": { "Enabled": true },
    "GraphQlServer": { "EnableTool": true, "IncludeExceptionDetails": true }
  },
  "Observability": {
    "OtlpEndpoint": "http://localhost:4317",
    "Pyroscope": { "ServerAddress": "http://localhost:4040" },
    "HealthChecks": {
      "ExposeDetails": true,
      "UiEnabled": true
    }
  }
}
