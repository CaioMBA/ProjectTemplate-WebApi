{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",

  "SecretResolution": {
    "MaxFileSizeBytes": 65536,
    "TrimTrailingNewLine": true,
    "AllowedRoots": []
  },

  "Settings": {
    "AppName": "WebApi Template",
    "AppVersion": "1.0.0",
    "PathBase": "",

    "Databases": [
      {
        "Id": "DEFAULT",
        "Type": "Postgresql",
        "Host": "postgres_app",
        "Port": 5432,
        "Database": "webapi_template",
        "Username": "webapi_template",
        "Password": "/run/secrets/webapi_template_db_password",
        "UseSsl": false,
        "TimeoutSeconds": 30,
        "Sql": {
          "MaxPoolSize": 100,
          "MigrateOnStartup": false,
          "LogInterpolatedSql": false,
          "Outbox": {
            "Enabled": false,
            "BrokerId": null,
            "PollIntervalSeconds": 10,
            "BatchSize": 50,
            "RetentionDays": 7
          },
          "PagedCache": {
            "CacheId": "DEFAULT",
            "MaxCachedPages": 50,
            "DefaultTtlMinutes": 5
          }
        }
      }
    ],

    "Apis": [],

    "Caches": [
      {
        "Id": "DEFAULT",
        "Type": "Memory",
        "DefaultTtlMinutes": 60
      }
    ],

    "Brokers": [],

    "Scheduling": {
      "Enabled": true,
      "Storage": {
        "Type": "Memory",
        "DatabaseId": null,
        "Schema": "hangfire"
      },
      "Workers": 5,
      "Queues": [ "default" ],
      "RetryAttempts": 3,
      "Dashboard": {
        "Enabled": false,
        "Path": "/hangfire",
        "ReadOnly": true
      },
      "Jobs": [
        { "Id": "outbox-cleanup", "Cron": "0 3 * * *", "Enabled": true, "TimeZone": "UTC" }
      ]
    }
  },

  "Api": {
    "Documentation": {
      "Enabled": false,
      "SwaggerUi": true,
      "Scalar": true,
      "SwaggerUiRoute": "swagger",
      "ScalarRoute": "scalar"
    },
    "GraphQlServer": {
      "Enabled": true,
      "Route": "/graphql",
      "EnableTool": false,
      "MaxExecutionDepth": 10,
      "IncludeExceptionDetails": false,
      "AutoSchema": {
        "ExcludeDatabases": [],
        "ExcludeSchemas": [],
        "ExcludeTables": [],
        "ExcludeColumns": [],
        "DefaultPageSize": 25,
        "MaxPageSize": 100,
        "MaxFilterDepth": 5,
        "MaxInValues": 500,
        "DocumentSampleSize": 200,
        "MaxScanItems": 10000,
        "FailOnIntrospectionError": false
      }
    },
    "Cors": {
      "Enabled": true,
      "PolicyName": "DefaultCorsPolicy",
      "AllowedOrigins": [],
      "AllowedMethods": [],
      "AllowedHeaders": [],
      "AllowCredentials": false,
      "PreflightMaxAgeSeconds": 600
    },
    "RateLimit": {
      "Enabled": true,
      "PolicyName": "DefaultRateLimitPolicy",
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 0,
      "RejectionStatusCode": 429
    },
    "ForwardedHeaders": {
      "Enabled": true,
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    }
  },

  "Observability": {
    "Enabled": true,
    "OtlpEndpoint": "http://monitoring_alloy:4317",
    "OtlpProtocol": "grpc",
    "ServiceName": "webapi-template",
    "ServiceNamespace": "homelab",
    "ServiceVersion": null,
    "DeploymentEnvironment": null,
    "EnableTracing": true,
    "EnableMetrics": true,
    "EnableLogging": true,
    "TraceSamplingRatio": 1.0,
    "RecordDatabaseStatements": false,
    "Pyroscope": {
      "Enabled": false,
      "ServerAddress": "http://monitoring_pyroscope:4040"
    },
    "HealthChecks": {
      "Path": "/health",
      "LivenessPath": "/live",
      "ReadinessPath": "/ready",
      "ExposeDetails": false,
      "TimeoutSeconds": 5,
      "UiEnabled": false,
      "UiPath": "/health-ui",
      "UiApiPath": "/health-ui-api",
      "UiEvaluationSeconds": 30
    }
  }
}
